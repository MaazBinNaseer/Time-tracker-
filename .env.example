# Online edition. On Vercel, set these in Project > Settings > Environment Variables
# (the database ones are added for you when you connect Upstash). For a local test run,
# copy this file to .env.local.

# Free cloud database (Upstash Redis). Either pair works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Signs login cookies. Make one with: openssl rand -hex 32
# Default: a random secret is made once and saved in the database.
# AUTH_SECRET=

# true = anyone with the link can create an account.
# Default: only the first account (the admin); the admin adds everyone else in Settings > Users.
# ALLOW_SIGNUP=true
